HTTP_ADDR=:8080
HTTP_ALLOWED_ORIGINS=*

POSTGRES_DSN=postgres://chat:chatpw@localhost:5432/chat?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CHANNEL=chat.messages

JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=24h
JWT_ISSUER=realtime-chat

LOG_LEVEL=info
LOG_FORMAT=text
